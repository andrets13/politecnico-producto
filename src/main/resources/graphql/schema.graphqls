type Producto {
    id: ID!
    nombre: String!
    descripcion: String!
    precio: Float!
}

input ProductoInput {
    nombre: String!
    descripcion: String!
    precio: Float!
}

type Query {
    productos: [Producto!]!
    producto(id: ID!): Producto!
}

type Mutation {
    crearProducto(input: ProductoInput!): Producto!
    actualizarProducto(id: ID!, input: ProductoInput!): Producto!
    eliminarProducto(id: ID!): Boolean!
}
